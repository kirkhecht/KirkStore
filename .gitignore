# Generated pipeline outputs — ignore everything under project/ except the final mixed files
project/*
!project/documentary/
project/documentary/*
!project/documentary/stories/
project/documentary/stories/*
!project/documentary/stories/mixed/
!project/documentary/stories/mixed/*.mp4

# Audio source files (large binaries — keep local only)
audio/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Whisper model cache
*.pt

# Misc
.DS_Store
*.log
.env
